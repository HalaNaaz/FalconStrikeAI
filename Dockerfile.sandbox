FROM python:3.11-alpine

# Create non-root unprivileged sandbox user and group (UID/GID 10001)
RUN addgroup -g 10001 sandboxgroup && \
    adduser -u 10001 -G sandboxgroup -s /sbin/nologin -D sandboxuser

WORKDIR /app

# Copy sandbox entrypoint package
COPY falconstrike/ /app/falconstrike/

# Set non-root ownership
RUN chown -R 10001:10001 /app

# Switch to non-root user UID 10001
USER 10001:10001

ENV PYTHONPATH=/app

CMD ["python", "-m", "falconstrike.sandbox_entrypoint", "--help"]

