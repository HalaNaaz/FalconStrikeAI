# ==============================================================================
# FALCON STRIKE-AI ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# IMPORTANT: DO NOT STORE REAL SECRETS IN SOURCE CONTROL.
# Copy this file to '.env' for local configuration.
# ==============================================================================

# Core Application Mode & Safety Controls
FALCON_ENVIRONMENT=development
FALCON_LOG_LEVEL=INFO

# SAFETY INVARIANT: DRY_RUN IS TRUE BY DEFAULT.
# Must explicitly set to false AND provide a valid FALCON_AUTH_TOKEN for live lab runs.
FALCON_DRY_RUN=true

# Target AWS Lab Account ID (Strictly isolated lab account only)
# The engine will refuse to execute against any account not in FALCON_ALLOWLISTED_ACCOUNTS
FALCON_TARGET_ACCOUNT_ID=000000000000
FALCON_ALLOWLISTED_ACCOUNTS=000000000000,123456789012

# Two-Key Authorisation Token (Required to exit dry-run mode)
# In production, this must be a signed, time-boxed RS256/HS256 JWT issued by an authorized lead/mentor.
FALCON_AUTH_TOKEN=
FALCON_AUTH_SECRET_KEY=falcon-strike-dev-secret-do-not-use-in-production

# Blast-Radius Safety Caps
FALCON_MAX_RESOURCES_TOUCHED=5
FALCON_MAX_RUN_DURATION_SECONDS=300
FALCON_RESOURCE_TAG_KEY=FalconStrike
FALCON_RESOURCE_TAG_VALUE=AdversaryEmulation

# REST API & Control Plane Settings
FALCON_API_HOST=127.0.0.1
FALCON_API_PORT=8000
FALCON_API_DEBUG=false

# Graph Database Settings (Neo4j)
# If unavailable, the engine falls back to the in-memory NetworkX graph provider.
FALCON_NEO4J_ENABLED=false
FALCON_NEO4J_URI=bolt://localhost:7687
FALCON_NEO4J_USER=neo4j
FALCON_NEO4J_PASSWORD=ChangeMeLabPassword!

# Command-and-Control (C2) Emulation Settings
# Traffic is directed strictly to lab-owned local sinks carrying inert marker tokens.
FALCON_C2_SINK_HOST=127.0.0.1
FALCON_C2_SINK_HTTP_PORT=8443
FALCON_C2_SINK_DNS_PORT=8053
FALCON_C2_BEACON_INTERVAL_SEC=5
FALCON_C2_BEACON_JITTER_PCT=20

# Audit Logging & Telemetry
FALCON_AUDIT_LOG_PATH=artifacts/logs/audit.jsonl
FALCON_TELEMETRY_ENABLED=true

